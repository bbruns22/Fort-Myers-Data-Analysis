lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving fortMyersWeather.zip to fortMyersWeather.zip\n","Archive:  fortMyersWeather.zip\n","  inflating: fortMyersGDD.txt        \n","  inflating: fortMyersCDD.txt        \n","  inflating: fortMyersTemp.txt       \n","  inflating: fortMyersPrecipitation.txt  \n","  inflating: fortMyersHDD.txt        \n"]},{"output_type":"execute_result","data":{"text/plain":["Text(1970, 71, 'Slope = 0.051 degrees/year')"]},"metadata":{},"execution_count":1},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# Import data and plotting library\n","from google.colab import files\n","import matplotlib.pyplot as plt\n","import pandas as pd\n","import numpy as np\n","\n","# Unzip all the files\n","print(\"Please upload the fortMyersWeather.zip file\")\n","uploaded = files.upload()\n","!unzip fortMyersWeather\n","\n","# Dataset file name\n","file = \"fortMyersTemp.txt\"\n","\n","# Read the file in\n","df = pd.read_csv(file, sep=\"\\\\s+\")\n","# Create a figure\n","plt.figure()\n","\n","# Start plotting\n","plt.plot(df['Year'], df['Annual'], color = \"black\", label = \"Data\")\n","\n","# Trendline over all data\n","slope, intercept = np.polyfit(df['Year'], df['Annual'], 1)\n","trendline = slope * df['Year'] + intercept\n","plt.plot(df['Year'], trendline, color = \"red\", label = \"Trendline since 1892\")\n","\n","# Trendline over last 50 years\n","past50 = df[df['Year'] > 1975]\n","slope2, intercept2 = np.polyfit(past50['Year'], past50['Annual'], 1)\n","trendline2 = slope2 * past50['Year'] + intercept2\n","plt.plot(past50['Year'], trendline2, color = \"blue\", label = \"Trendline over past 50 Years\")\n","\n","# Labels\n","plt.xlabel(\"Year\", fontsize = \"11\")\n","plt.ylabel(\"Temperature (degrees)\", fontsize = \"11\")\n","plt.title(\"Average Temperature in Fort Myers, FL since 1892\", fontsize = \"14\")\n","plt.legend()\n","\n","# Print the slopes\n","plt.text(1970, 71.3, f\"Slope = {slope:.3f} degrees/year\", color = \"r\")\n","plt.text(1970, 71, f\"Slope = {slope2:.3f} degrees/year\", color = \"b\")\n"]},{"cell_type":"markdown","metadata":{"id":"hvB8uK_8KDNg"},"source":["The Average Temperature vs Year graph above depicts a general upward trend. This means that, over time, the average temperature increases, showing that the Fort Myers area exhibits global warming to some extent.\n","\n","The red and blue lines depict trendlines over the entire data and the past 50 years, respectively. The slope that depicts global warming over the last 50 years is double that over the entire dataset. This means that not only is the average temperature increasing over time, the rate at which it increases is also increasing. This means that global warming has become more severe over recent years and will likely continue in that direction.\n","\n","In order to measure these effects, a projection is given below to show what the average temperature in Fort Myers, FL could potentially look like 100 years into the future. Please click on the code segment below and press run to view the graph."]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":509},"id":"qcC-Lb40PQvM","executionInfo":{"status":"ok","timestamp":1765349542238,"user_tz":360,"elapsed":225,"user":{"displayName":"David Gray","userId":"09426756811334309153"}},"outputId":"187ff438-8cf1-43f7-d14a-aad3c7c81ab4"},"outputs":[{"output_type":"stream","name":"stdout","text":["Using data since 1892, the average temperature is expected to rise 2.597 degrees over the next 100 years\n","Using data from the last 50 years, the average temperature is expected to rise 5.127 degrees over the next 100 years\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# Benjamin Bruns\n","# Import data and plotting library\n","import matplotlib.pyplot as plt\n","import pandas as pd\n","import numpy as np\n","\n","# Creates the same figure as above\n","file = \"fortMyersTemp.txt\"\n","\n","df = pd.read_csv(file, sep=\"\\\\s+\")\n","\n","plt.figure()\n","\n","plt.plot(df['Year'], df['Annual'], color = \"black\", label = \"Data\")\n","\n","# Extend the trendlines from above to make a projection. Since 1892\n","slope, intercept = np.polyfit(df['Year'], df['Annual'], 1)\n","xvals = np.linspace(1892, 2125, 234)\n","yvals = []\n","for x in xvals:\n","  yvals.append(slope * (x) + intercept)\n","plt.plot(xvals, yvals, color = \"red\", label = \"Trendline since 1892\")\n","\n","# Extending trendlines from data over 50 years\n","past50 = df[df['Year'] > 1975]\n","slope2, intercept2 = np.polyfit(past50['Year'], past50['Annual'], 1)\n","xvals2 = np.linspace(1975, 2125, 151)\n","yvals2 = []\n","for x in xvals2:\n","  yvals2.append(slope2 * (x) + intercept2)\n","plt.plot(xvals2, yvals2, color = \"blue\", label = \"Trendline over past 50 Years\")\n","\n","# Labels\n","plt.xlabel(\"Year\", fontsize = \"11\")\n","plt.ylabel(\"Temperature (degrees)\", fontsize = \"11\")\n","plt.title(\"Projection of Future Temperatures in Fort Myers, FL\", fontsize = \"14\")\n","plt.legend()\n","\n","# Get the change in temperature over the next 100 years\n","change = yvals[233] - yvals[133]\n","change2 = yvals2[150] - yvals2[50]\n","\n","# Print the change\n","print(f\"Using data since 1892, the average temperature is expected to rise {change:.3f} degrees over the next 100 years\")\n","print(f\"Using data from the last 50 years, the average temperature is expected to rise {change2:.3f} degrees over the next 100 years\")\n","\n"]},{"cell_type":"markdown","metadata":{"id":"fsjKzeRHKFiR"},"source":["The model above predicts that global warming will produce an increase in average temperature of about 5 degrees over the next 100 years. This is based on the trendline created using data from the past 50 years recorded in Fort Myers, FL but does not take into account the increasing change in the rate of global warming. This would mean that the average temperature by month in Fort Myers, FL in the year 2125 would be around 82 degrees and increasing."]},{"cell_type":"markdown","metadata":{"id":"h1xoz0WznCgy"},"source":["## Average Precipitation"]},{"cell_type":"markdown","metadata":{"id":"eekQQ0GAnZfu"},"source":["The Fort Myers precipitation dataset measures the average amount of rainfall the area receives each year, showing how that value changes over time. The trends in the data help reveal whether the region is getting wetter, drier, or more unpredictable. Studying these trends is important because shifts in precipitation affect things like water resources, increases flooding risks, and ecosystems. Projecting the future helps people prepare for possible challenges, such as managing droughts or handling heavier storms. Studying past and future patterns allows people to make better decisions to adapt to changes in the climate."]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":635},"id":"b5XB7HfXz4jN","executionInfo":{"status":"ok","timestamp":1765349545948,"user_tz":360,"elapsed":320,"user":{"displayName":"David Gray","userId":"09426756811334309153"}},"outputId":"04824b27-f97e-4016-fb6e-da1f093fc45c"},"outputs":[{"output_type":"stream","name":"stderr","text":["/tmp/ipython-input-2593026434.py:8: FutureWarning: The 'delim_whitespace' keyword in pd.read_csv is deprecated and will be removed in a future version. Use ``sep='\\s+'`` instead\n","  return pd.read_csv(filename, delim_whitespace=True)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Slope of present data: 0.000 inches/year\n","Slope over last 20 years: -0.001 inches/year\n"]}],"source":["#Will Shoaf\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import numpy as np\n","\n","\n","def load_data(filename):\n","    return pd.read_csv(filename, delim_whitespace=True)\n","\n","\n","def calculate_trendline(x, y):\n","    slope, intercept = np.polyfit(x, y, 1)\n","    trend = slope * x + intercept\n","    return slope, intercept, trend\n","\n","\n","def plot_precipitation_present(df):\n","    df_present = df[df['Year'] <= 2020]\n","\n","    plt.figure(figsize=(10,6))\n","    plt.plot(df_present['Year'], df_present['Annual'], 'k-', label=\"Data\")\n","\n","    slope_all, _, trend_all = calculate_trendline(df_present['Year'], df_present['Annual'])\n","    plt.plot(df_present['Year'], trend_all, 'r', label=\"Trendline\")\n","\n","    last_20 = df_present[df_present['Year'] > (df_present['Year'].max() - 20)]\n","    slope_20, _, trend_20 = calculate_trendline(last_20['Year'], last_20['Annual'])\n","    plt.plot(last_20['Year'], trend_20, 'b', label=\"Trendline last 20 yrs\")\n","\n","    plt.xlabel(\"Year\", fontsize=11)\n","    plt.ylabel(\"Average Precipitation (inches)\", fontsize=11)\n","    plt.title(\"Average Precipitation in Fort Myers, FL\", fontsize=14)\n","    plt.legend()\n","    plt.show()\n","\n","    print(f\"Slope of present data: {slope_all:.3f} inches/year\")\n","    print(f\"Slope over last 20 years: {slope_20:.3f} inches/year\")\n","\n","\n","if __name__ == \"__main__\":\n","    data_file = \"fortMyersPrecipitation.txt\"\n","    df = load_data(data_file)\n","    plot_precipitation_present(df)"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":635},"id":"BL-bhxujz4jP","executionInfo":{"status":"ok","timestamp":1765349548779,"user_tz":360,"elapsed":232,"user":{"displayName":"David Gray","userId":"09426756811334309153"}},"outputId":"79f88e11-c935-4c4b-acc6-5d93ed6c404e"},"outputs":[{"output_type":"stream","name":"stderr","text":["/tmp/ipython-input-2396593441.py:7: FutureWarning: The 'delim_whitespace' keyword in pd.read_csv is deprecated and will be removed in a future version. Use ``sep='\\s+'`` instead\n","  return pd.read_csv(filename, delim_whitespace=True)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Slope since 2000: 0.000 inches/year\n","Slope over last 20 years: 0.001 inches/year\n"]}],"source":["#Will Shoaf\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","import numpy as np\n","\n","def load_data(filename):\n","    return pd.read_csv(filename, delim_whitespace=True)\n","\n","def calculate_trendline(x, y, future_years=50):\n","    slope, intercept = np.polyfit(x, y, 1)\n","    x_extended = np.arange(x.min(), x.max() + future_years + 1)\n","    trend_extended = slope * x_extended + intercept\n","    return slope, intercept, x_extended, trend_extended\n","\n","def plot_precipitation_future(df, start_year=2000, future_years=50):\n","    df_future = df[df['Year'] >= start_year]\n","\n","    plt.figure(figsize=(10,6))\n","    plt.plot(df_future['Year'], df_future['Annual'], 'k-', label=f\"Data ({start_year}+)\")\n","\n","    slope_all, _, x_ext_all, trend_all = calculate_trendline(df_future['Year'], df_future['Annual'], future_years)\n","    plt.plot(x_ext_all, trend_all, 'r', label=f\"Trendline last 20 yrs projected 50 yrs)\")\n","\n","    last_20 = df_future[df_future['Year'] > (df_future['Year'].max() - 20)]\n","    slope_20, _, x_ext_20, trend_20 = calculate_trendline(last_20['Year'], last_20['Annual'], future_years)\n","    plt.plot(x_ext_20, trend_20, 'b', label=f\"Trendline last 20 yrs (projected 50 yrs)\")\n","\n","    plt.xlabel(\"Year\", fontsize=11)\n","    plt.ylabel(\"Average Precipitation (inches)\", fontsize=11)\n","    plt.title(f\"Average Precipitation in Fort Myers, FL Since 2000 + Future Predicitions\", fontsize=14)\n","    plt.legend()\n","    plt.show()\n","\n","    print(f\"Slope since {start_year}: {slope_all:.3f} inches/year\")\n","    print(f\"Slope over last 20 years: {slope_20:.3f} inches/year\")\n","\n","if __name__ == \"__main__\":\n","    data_file = \"fortMyersPrecipitation.txt\"\n","    df = load_data(data_file)\n","    plot_precipitation_future(df, start_year=2000, future_years=50)"]},{"cell_type":"markdown","metadata":{"id":"fFMW35shnCoK"},"source":["## HDD - Heating Degree Days"]},{"cell_type":"markdown","metadata":{"id":"y2h6-0iJKIt5"},"source":["HDD is an abbreviation for heating degree days, a measure of how cold the temperature is in relation to energy for heating buildings. This makes it a good way to measure the effect of increasinag temperature environmentally on society. HDD per day is calculated by finding the average temperature for a specific day and then adding 1 heating degree day for every degree that the average temperature is below 65 degrees Fahrenheit. For example, an average temperature of 55 degrees on a day would translate to 10 heating degree days while an average temperature of 70 degrees would be 0 heating degree days.\n","\n","Given below is a graph that depicts the sum of heating degree days per year over time. Because we have proved that average temperature has increased over time in Fort Myers, FL, it would make sense that there would be less heating degree days over time. This would be proved by a downward slope in the trendlines of the graph. Please press the run button in the code block below to view the graph."]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":491},"id":"l2ZvtEHGNgH2","executionInfo":{"status":"ok","timestamp":1765349551845,"user_tz":360,"elapsed":283,"user":{"displayName":"David Gray","userId":"09426756811334309153"}},"outputId":"ddb4e417-f3b6-4089-f795-a8296fd5c30f"},"outputs":[{"output_type":"execute_result","data":{"text/plain":["Text(1975, 725, 'Slope = -4.533 HDD/year')"]},"metadata":{},"execution_count":5},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# Import data and plotting library\n","import matplotlib.pyplot as plt\n","import pandas as pd\n","import numpy as np\n","\n","\n","# Dataset file name\n","file = \"fortMyersHDD.txt\"\n","\n","# Read the file in\n","df = pd.read_csv(file, sep=\"\\\\s+\")\n","# Create a figure\n","plt.figure()\n","\n","# Start plotting\n","plt.plot(df['Year'], df['Annual'], color = \"black\", label = \"Data\")\n","\n","# Trendline over all data\n","slope, intercept = np.polyfit(df['Year'], df['Annual'], 1)\n","trendline = slope * df['Year'] + intercept\n","plt.plot(df['Year'], trendline, color = \"red\", label = \"Trendline since 1892\")\n","\n","# Trendline over last 50 years\n","past50 = df[df['Year'] > 1975]\n","slope2, intercept2 = np.polyfit(past50['Year'], past50['Annual'], 1)\n","trendline2 = slope2 * past50['Year'] + intercept2\n","plt.plot(past50['Year'], trendline2, color = \"blue\", label = \"Trendline over past 50 Years\")\n","\n","# Labels\n","plt.xlabel(\"Year\", fontsize = \"11\")\n","plt.ylabel(\"Heating Degree Days\", fontsize = \"11\")\n","plt.title(\"Total Heating Degree Days Per Year in Fort Myers, FL since 1892\", fontsize = \"14\")\n","plt.legend()\n","\n","# Print the slope\n","plt.text(1975, 755, f\"Slope = {slope:.3f} HDD/year\", color = \"r\")\n","plt.text(1975, 725, f\"Slope = {slope2:.3f} HDD/year\", color = \"b\")\n"]},{"cell_type":"markdown","metadata":{"id":"QLpXd3Q9KKa4"},"source":["The Total Heating Degree Days Per Year in Fort Myers, FL have decreased over time. Since 1892, there has been an average decrease of about 1 heating degree day per year but over the past 50 years, there has been a decrease of 4.5 heating degree days per year in Fort Myers, FL. This means that consumers in Fort Myers, FL over recent years have needed to consume less energy in order to heat their homes.\n","\n","A decrease in energy consumption is a net positive to save energy and reduce pollution, but the rate at which it decreases might become an issue. Using the slopes of the trendline in the graph above, a projection for what heating degree days might be in 30 years is given below. Please click on the code segment and press run to view the graph."]},{"cell_type":"code","execution_count":null,"metadata":{"cola